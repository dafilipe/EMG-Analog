void setup() {
    Serial.begin(115200);

    analogReadResolution(12);
}

void loop() {

  // Obtain the input analog value from the ADC
  x[0] = (float) analogRead(ADC_PIN) * 3.3 / 4095.0;

  // FIR digital filter implementation
  y[0] = 0.0;

  for (int i = 0; i < FIR_TAP_NUM; i++) {
    y[0] += fir_coefficients[i] * x[i];
  }

  // Convert the digital filter output to analog
  // (DAC/PWM output to be configured)
  // int dacVoltage = (int)(y[0] * 1023.0 / 3.3);
  // analogWrite(DAC_PIN, dacVoltage);

  // For the serial monitor
  Serial.print(x[0]);
  Serial.print(" ");
  Serial.println(y[0]);

  // delay(1); // Has an impact on the effective sampling rate

  // Update x data vector
  for (int i = 39; i >= 0; i--) {
    x[i+1] = x[i];
  }

}
