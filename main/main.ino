#define ADC_PIN 26  // GP26 - ADC0 (Pico 2 W)

#define FIR_TAP_NUM 41

// Input and output values
float x[FIR_TAP_NUM] = {0.0};
float y[1] = {0.0};

// FIR coefficients generated by T-Filter (41 taps)
const float fir_coefficients[FIR_TAP_NUM] = {
